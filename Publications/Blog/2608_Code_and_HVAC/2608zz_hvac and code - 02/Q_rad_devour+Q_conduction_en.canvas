{
	"nodes":[
		{"id":"e44d1fe9914abd3a","type":"text","text":"$$\nQ_{rad, i} = (q_d \\cdot K_1 + q_nd \\cdot K_2) \\cdot K3 \\cdot K4 \\cdot A_{gl} \\tag{3}\n$$\nHeat flux, W, of solar radiation through a glazed light opening","x":-600,"y":1421,"width":540,"height":125},
		{"id":"db1d18dfa89f2308","type":"text","text":"$$\nQ_{\\delta t, i} = (t_{out-day-mid} + 0.5 \\cdot A_{air-day} \\cdot theta - t_{in}) \\cdot (A_{gl} / R) \\tag{18}\n$$\nThe heat transfer flux, W, for a given hour of the day through a glazed light opening","x":-600,"y":1840,"width":540,"height":140},
		{"id":"68880bd35042a2ad","type":"text","text":"$$\nQ_{glass, i} = Q_{rad,i} \\cdot a_{d, i} + Q_{\\delta t, i} \\tag{2}\n$$\nHeat flux through the i-th light opening","x":160,"y":1621,"width":320,"height":125},
		{"id":"514bd370f8078475","type":"text","text":"$K_4$ - heat transmission coefficient of glazing for light openings","x":-2184,"y":1111,"width":477,"height":80},
		{"id":"115bb6a69c50ae9c","type":"text","text":"$A_{gl}$ - area of the light opening (glazing)","x":-2184,"y":1318,"width":479,"height":73},
		{"id":"fd6b6ef1a0f97f46","type":"text","text":"R -   reduced thermal resistance of glazing for the light opening, $m^2С/W$.","x":-2180,"y":1414,"width":475,"height":70},
		{"id":"e2d583f8d4fce9a7","type":"text","text":"Latitude","x":-2184,"y":1638,"width":477,"height":50},
		{"id":"0e4c3c1c40adb1c1","type":"text","text":"Hour of day","x":-2182,"y":1810,"width":477,"height":61},
		{"id":"79753560fc1a4452","type":"text","text":"$t_{in}$ - indoor air temperature","x":-2180,"y":1521,"width":475,"height":50},
		{"id":"4262485e48ab6640","type":"text","text":"$q_d$ - DIRECT surface density of the heat flux, W/m², through a glazed light opening for a given hour","x":-1540,"y":1671,"width":475,"height":120},
		{"id":"b4ce95d0bea29326","type":"text","text":"$q_nd$ - DIFFUSE surface density of the heat flux, W/m², through a glazed light opening for a given hour","x":-1544,"y":1828,"width":479,"height":126},
		{"id":"458a06819e70cf20","type":"text","text":"$t_{out-day-mid}$ - average daily outdoor air temperature;","x":-1540,"y":2010,"width":479,"height":80},
		{"id":"bb0fcc67c50df712","type":"text","text":"$A_{air-day}$ - maximum daily amplitude of outdoor air temperature;","x":-1538,"y":2110,"width":475,"height":80},
		{"id":"36535bf2d7654f95","type":"text","text":"$\\theta$ - coefficient expressing the harmonic variation of outdoor air temperature","x":-1540,"y":2210,"width":479,"height":90},
		{"id":"90559a5cc2cdebbd","type":"text","text":"$K_1$ - insolation coefficients for direct solar radiation to account for the area of the light opening","x":-2184,"y":777,"width":477,"height":94},
		{"id":"fc2eb4a497131f04","type":"text","text":"$K_2$ - insolation coefficients to account for diffuse solar radiation entering through light openings","x":-2184,"y":891,"width":477,"height":100},
		{"id":"fdb40dfcb523ee2b","type":"text","text":"$K_3$ - heat transmission coefficients of solar protection devices","x":-2184,"y":1011,"width":477,"height":80},
		{"id":"49bc073eddda9e80","type":"text","text":"$a_d$ - absorption factor of the solar radiation heat flux  ","x":-405,"y":1273,"width":345,"height":81},
		{"id":"53d6c9db8b469a04","type":"text","text":"The hour of the beginning of direct radiation","x":-760,"y":1244,"width":260,"height":59},
		{"id":"8ec96db553f8b345","type":"text","text":"$\\frac{\\sum{Y}}{\\bigtriangleup}$","x":-760,"y":1160,"width":260,"height":59},
		{"id":"89aa6f78f518cc8d","type":"text","text":"Location","x":-2960,"y":1822,"width":477,"height":69},
		{"id":"c579b0e318b3624b","type":"text","text":"Sun protection devices","x":-2960,"y":1022,"width":477,"height":50},
		{"id":"6ecacb6528e7b664","type":"text","text":"Glazing of the light opening","x":-2960,"y":1130,"width":477,"height":69},
		{"id":"5b5c42b8fb08b76b","type":"text","text":"Indoor climate parameters","x":-2960,"y":1226,"width":477,"height":69},
		{"id":"563c342c09cc4db3","type":"text","text":"Orientation relative to the cardinal directions","x":-2184,"y":680,"width":477,"height":53},
		{"id":"a18f4ca7b19aa897","type":"text","text":"$\\sum{Y}$\nAn indicator of the total absorption of heat by fences and indoor equipment. ","x":-1210,"y":683,"width":580,"height":100},
		{"id":"c80ad811f4113e19","type":"text","text":"$\\bigtriangleup$\nAn indicator of the intensity of convective heat exchange in a room","x":-1210,"y":803,"width":580,"height":100}
	],
